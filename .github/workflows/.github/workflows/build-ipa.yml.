
name: Build Educraft IPA

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: macos-14

    steps:
      - name: Baixar repositorio
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Localizar e extrair ZIP
        run: |
          mkdir -p extracted
          ZIP_FILE=$(find . -maxdepth 1 -iname '*.zip' -print -quit)
          if [ -z "$ZIP_FILE" ]; then
            echo "ERRO: nenhum ZIP encontrado na raiz."
            exit 1
          fi
          unzip -q "$ZIP_FILE" -d extracted
          PACKAGE_FILE=$(find extracted -name package.json -print -quit)
          if [ -z "$PACKAGE_FILE" ]; then
            echo "ERRO: package.json nao encontrado no ZIP."
            exit 1
          fi
          echo "PROJECT_DIR=$(dirname "$PACKAGE_FILE")" >> "$GITHUB_ENV"

      - name: Instalar dependencias
        run: |
          cd "$PROJECT_DIR"
          npm ci || npm install

      - name: Preparar projeto Capacitor
        run: |
          cd "$PROJECT_DIR"
          npx cap sync ios

      - name: Compilar aplicativo iOS
        run: |
          cd "$PROJECT_DIR"
          xcodebuild \
            -workspace ios/App/App.xcworkspace \
            -scheme App \
            -configuration Release \
            -sdk iphoneos \
            -destination 'generic/platform=iOS' \
            -derivedDataPath "$RUNNER_TEMP/DerivedData" \
            CODE_SIGNING_ALLOWED=NO \
            build

      - name: Gerar IPA
        run: |
          APP="$RUNNER_TEMP/DerivedData/Build/Products/Release-iphoneos/App.app"
          test -d "$APP"
          mkdir -p "$RUNNER_TEMP/package/Payload"
          cp -R "$APP" "$RUNNER_TEMP/package/Payload/"
          cd "$RUNNER_TEMP/package"
          zip -qr "$GITHUB_WORKSPACE/Educraft-unsigned.ipa" Payload

      - name: Disponibilizar IPA
        uses: actions/upload-artifact@v4
        with:
          name: Educraft-IPA
          path: Educraft-unsigned.ipa
